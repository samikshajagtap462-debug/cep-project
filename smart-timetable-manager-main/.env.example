# ==========================================================
# EduNova Smart Faculty Timetable Management System
# Production & Local Environment Configuration
# ==========================================================

# Port for the web server (Render automatically sets this to 10000)
PORT=5000

# Flask Debug Mode (set to false for production)
FLASK_DEBUG=false

# Secret key for signing JWT tokens and securing sessions
# In production, set to a cryptographically secure random string
EDUNOVA_SECRET_KEY=change-this-to-a-secure-random-secret-key
# Alternative standard name supported:
# SECRET_KEY=change-this-to-a-secure-random-secret-key

# SQLite Database Path
# On Render with a Persistent Disk mounted at /var/data:
DATABASE_PATH=/var/data/edunova.db

# Optional: SQLAlchemy Database Connection URL (Defaults to SQLite if left empty)
# SQLite example: sqlite:////var/data/edunova.db
# PostgreSQL example: postgresql://user:password@hostname:5432/edunova
# DATABASE_URL=
